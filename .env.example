# ==============================
# Бэкенд Настройки
# ==============================
BACKEND_TITLE="Moscow Transport Predictor"
BACKEND_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PREDICTION_CACHE_TTL=600
BACKEND_TELEMETRY_MAX_HISTORY=50
BACKEND_STOP_SPEED_THRESHOLD_KMH=5.0
BACKEND_ML_TELEMETRY_WINDOW_MINUTES=30
BACKEND_MAX_IDLE_GAP_S=120.0
BACKEND_HISTORICAL_PACKET_DELAY_S=300.0

# NDTP Сервер
BACKEND_NDTP_HOST=0.0.0.0
BACKEND_NDTP_PORT=9201

# Связь с ML
BACKEND_ML_TIMEOUT=10.0

# ==============================
# ML Настройки
# ==============================
ML_TITLE="Transport delay predictor"
ML_VERSION="1.0"
ML_DEBUG=false
ML_HOST=0.0.0.0
ML_PORT=8001
ML_WORKERS=1
ML_MODEL_DIR="/app/ml/artifacts"
ML_STRATEGY="schedule_ensemble"

# ==============================
# База Данных (PostgreSQL)
# ==============================
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=transport

# ==============================
# Кэш (Redis)
# ==============================
REDIS_PORT=6379

# ==============================
# Frontend Настройки
# ==============================
FRONTEND_PORT=80
VITE_API_URL=
VITE_WS_URL=
VITE_YANDEX_MAP_API_KEY=
VITE_HEALTH_CHECK_INTERVAL=30000
